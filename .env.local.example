# 헤이유미 REST API 키 (Authorization: Bearer)
HEYYUMI_API_KEY=
# 1 = 샌드박스 (사장님께 알림 안 감, 8초 뒤 가짜 응답). 실제 발표 때만 0으로.
HEYYUMI_SANDBOX=1
# 선택: 언어 처리용 Claude 키. 없으면 간단한 규칙 기반으로 동작해요.
ANTHROPIC_API_KEY=
# 선택: 카카오 로그인
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 배포(Vercel): Neon Postgres 연결 주소. 비워 두면 로컬 SQLite(.data/app.db)를 씀
DATABASE_URL=
# 배포(Vercel)에서는 필수: 세션 서명용 긴 임의 문자열
SESSION_SECRET=
# 사장님 초대 코드 (코드:매장ID, 쉼표로 여러 개)
OWNER_INVITES=
